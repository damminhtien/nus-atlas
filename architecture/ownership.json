{
  "version": "nus.architecture-ownership.v1",
  "rules": [
    { "pattern": "content/**", "role": "canonical", "editable": true },
    { "pattern": "schemas/**", "role": "canonical", "editable": true },
    { "pattern": "src/**", "role": "source", "editable": true },
    { "pattern": "tools/**", "role": "source", "editable": true },
    { "pattern": "scripts/**", "role": "source", "editable": true },
    { "pattern": "tests/**", "role": "source", "editable": true },
    { "pattern": "data/extracted/**", "role": "source", "editable": true },
    { "pattern": "dist/**", "role": "generated", "editable": false }
  ],
  "authorityOrder": ["canonical", "source", "generated"]
}
