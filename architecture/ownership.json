{
  "version": "nus.architecture-ownership.v1",
  "rules": [
    { "pattern": "content/**", "role": "canonical", "editable": true },
    { "pattern": "schemas/**", "role": "canonical", "editable": true },
    { "pattern": "src/**", "role": "source", "editable": true },
    { "pattern": "tools/**", "role": "source", "editable": true },
    { "pattern": "scripts/**", "role": "source", "editable": true },
    { "pattern": "tests/**", "role": "source", "editable": true },
    { "pattern": "data/extracted/**", "role": "source", "editable": true },
    { "pattern": "dist/**", "role": "generated", "editable": false },
    { "pattern": "api/**", "role": "source", "editable": true },
    { "pattern": "assets/**", "role": "source", "editable": true },
    { "pattern": "css/**", "role": "source", "editable": true },
    { "pattern": "js/**", "role": "source", "editable": true },
    { "pattern": "index.html", "role": "source", "editable": true },
    { "pattern": "manifest.webmanifest", "role": "source", "editable": true },
    { "pattern": "sw.js", "role": "source", "editable": true },
    { "pattern": "prerender.js", "role": "source", "editable": true },
    { "pattern": "nus-gate.js", "role": "source", "editable": true },
    { "pattern": "icon.svg", "role": "source", "editable": true }
  ],
  "authorityOrder": ["canonical", "source", "generated"]
}
