{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/question.schema.json",
  "title": "NUS Atlas question",
  "type": "object",
  "required": ["id", "entityKey", "courseId", "lessonId", "type", "difficulty", "skill", "cognitiveLevel", "estimatedSeconds", "prompt", "explanation", "misconception", "visualHook", "sourceRefs", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityKey": { "type": "string", "pattern": "^[^:]+:[^/]+/.+$" },
    "courseId": { "type": "string", "minLength": 1 },
    "lessonId": { "type": "string", "minLength": 1 },
    "examEligible": { "type": "boolean" },
    "type": { "enum": ["mcq", "short", "derivation", "calculation"] },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "skill": { "type": "string", "minLength": 1 },
    "cognitiveLevel": { "type": "string", "minLength": 1 },
    "estimatedSeconds": { "type": "integer", "minimum": 15 },
    "prompt": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 1 },
    "misconception": { "type": "string", "minLength": 1 },
    "visualHook": { "type": "string", "minLength": 1 },
    "sourceRefs": { "type": "array", "minItems": 1 },
    "schemaVersion": { "const": "nus.question.v1" }
  },
  "additionalProperties": true
}
