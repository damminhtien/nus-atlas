{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/lesson.schema.json",
  "title": "NUS Atlas lesson",
  "type": "object",
  "required": ["id", "entityKey", "courseId", "moduleId", "title", "blocks", "sourceRefs", "questionIds", "labIds", "visualIds", "slideSetIds", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityKey": { "type": "string", "pattern": "^[^:]+:[^/]+/.+$" },
    "courseId": { "type": "string", "minLength": 1 },
    "moduleId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } },
    "sourceRefs": { "type": "array", "items": { "$ref": "source.schema.json" } },
    "questionIds": { "type": "array", "items": { "type": "string" } },
    "labIds": { "type": "array", "items": { "type": "string" } },
    "visualIds": { "type": "array", "items": { "type": "string" } },
    "slideSetIds": { "type": "array", "items": { "type": "string" } },
    "schemaVersion": { "const": "nus.lesson.v1" }
  },
  "$defs": {
    "sourceRef": { "type": "object", "required": ["sourceId", "sourceType", "page"], "properties": { "sourceId": { "type": "string" }, "sourceType": { "type": "string" }, "page": { "type": "integer", "minimum": 1 } }, "additionalProperties": true },
    "block": {
      "type": "object",
      "required": ["id", "type", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["teaching-note", "formula", "worked-example", "critical-question"] },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "formula" } } }, "then": { "required": ["name", "purpose", "latex"] } },
        { "if": { "properties": { "type": { "const": "teaching-note" } } }, "then": { "required": ["title", "body"] } },
        { "if": { "properties": { "type": { "const": "worked-example" } } }, "then": { "required": ["title", "steps"] } },
        { "if": { "properties": { "type": { "const": "critical-question" } } }, "then": { "required": ["prompt"] } }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
