{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/lesson.schema.json",
  "title": "NUS Atlas lesson",
  "type": "object",
  "required": ["id", "courseId", "moduleId", "title", "blocks", "sourceRefs", "questionIds", "labIds", "schemaVersion"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "courseId": { "type": "string", "minLength": 1 },
    "moduleId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "blocks": { "type": "array" },
    "sourceRefs": { "type": "array", "items": { "$ref": "source.schema.json" } },
    "questionIds": { "type": "array", "items": { "type": "string" } },
    "labIds": { "type": "array", "items": { "type": "string" } },
    "schemaVersion": { "const": "nus.lesson.v1" }
  },
  "additionalProperties": true
}
