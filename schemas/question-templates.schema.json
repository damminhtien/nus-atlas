{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/question-templates.schema.json",
  "title": "NUS Atlas question template catalog",
  "type": "object",
  "required": ["schemaVersion", "courseId", "archetypes", "cards", "templates"],
  "properties": {
    "schemaVersion": { "const": "nus.question-templates.v1" },
    "courseId": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "archetypes": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/archetype" } },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } },
    "templates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/template" } }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["sourceId", "sourceType", "page"],
      "properties": { "sourceId": { "type": "string", "minLength": 1 }, "sourceType": { "enum": ["lecture", "exercise", "textbook", "ref", "assessment-derived"] }, "page": { "type": "integer", "minimum": 1 }, "url": { "type": "string", "format": "uri" } },
      "additionalProperties": true
    },
    "archetype": { "type": "object", "required": ["id", "label", "description"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } }, "additionalProperties": true },
    "card": { "type": "object", "required": ["id", "lessonId", "title", "objective", "anchor", "lectureRefs"], "properties": { "id": { "type": "string", "minLength": 1 }, "lessonId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "objective": { "type": "string", "minLength": 1 }, "anchor": { "type": "string", "pattern": "^nus-study-card-" }, "lectureRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } } }, "additionalProperties": true },
    "template": { "type": "object", "required": ["id", "archetype", "cardId", "lessonId", "questionType", "skill", "problemDefinition", "assumptions", "coreInvariant", "formulaAlgorithm", "failureModes", "sourceRefs"], "properties": { "id": { "type": "string", "minLength": 1 }, "archetype": { "type": "string", "minLength": 1 }, "cardId": { "type": "string", "minLength": 1 }, "lessonId": { "type": "string", "minLength": 1 }, "questionType": { "type": "string", "minLength": 1 }, "skill": { "type": "string", "minLength": 1 }, "generatorId": { "type": "string", "minLength": 1 }, "problemDefinition": { "type": "string", "minLength": 1 }, "assumptions": { "type": "string", "minLength": 1 }, "coreInvariant": { "type": "string", "minLength": 1 }, "formulaAlgorithm": { "type": "string", "minLength": 1 }, "failureModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
