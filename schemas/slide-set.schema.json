{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/slide-set.schema.json",
  "title": "NUS Atlas slide set",
  "type": "object",
  "required": ["schemaVersion", "id", "courseId", "source", "slides"],
  "properties": {
    "schemaVersion": { "const": "nus.slide-set.v1" },
    "id": { "type": "string", "minLength": 1 },
    "courseId": { "type": "string", "minLength": 1 },
    "lessonIds": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "object", "required": ["sourceId", "sourceType", "pageCount"], "properties": { "sourceId": { "type": "string" }, "sourceType": { "const": "lecture" }, "pageCount": { "type": "integer", "minimum": 1 } }, "additionalProperties": true },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } }
  },
  "$defs": {
    "bbox": { "type": "object", "required": ["left", "top", "right", "bottom"], "properties": { "left": { "type": "number" }, "top": { "type": "number" }, "right": { "type": "number" }, "bottom": { "type": "number" } }, "additionalProperties": true },
    "sourceRef": { "type": "object", "required": ["sourceId", "sourceType", "page"], "properties": { "sourceId": { "type": "string" }, "sourceType": { "type": "string" }, "page": { "type": "integer", "minimum": 1 } }, "additionalProperties": true },
    "slide": {
      "type": "object",
      "required": ["slideId", "slideNumber", "pdfPage", "sourceRef", "extraction", "explanation", "socraticQuestions"],
      "properties": {
        "slideId": { "type": "string" },
        "slideNumber": { "type": "integer", "minimum": 1 },
        "pdfPage": { "type": "integer", "minimum": 1 },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "assetPath": { "type": "string" },
        "extraction": { "type": "object", "required": ["sourceId", "page", "blocks"], "properties": { "sourceId": { "type": "string" }, "page": { "type": "integer", "minimum": 1 }, "blocks": { "type": "array", "items": { "type": "object", "required": ["blockId", "type", "page", "sourceId", "bbox"], "properties": { "blockId": { "type": "string" }, "type": { "type": "string" }, "page": { "type": "integer", "minimum": 1 }, "sourceId": { "type": "string" }, "bbox": { "$ref": "#/$defs/bbox" }, "imageId": { "type": ["string", "null"] }, "text": { "type": "string" } }, "additionalProperties": true } } }, "additionalProperties": true },
        "explanation": { "type": "object", "required": ["whatYouSee", "whyItMatters", "intuition", "technicalDetail", "pitfall", "connection"], "additionalProperties": { "type": "string" } },
        "textbookRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "referenceRefs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "socraticQuestions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "prompt", "answer", "hint"], "properties": { "type": { "type": "string" }, "prompt": { "type": "string" }, "answer": { "type": "string" }, "hint": { "type": "string" } }, "additionalProperties": true } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
