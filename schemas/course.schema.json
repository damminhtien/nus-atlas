{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/course.schema.json",
  "title": "NUS Atlas course package",
  "type": "object",
  "required": ["code", "entityKey", "title", "schemaVersion", "moduleIds", "assessmentIds", "slideSetIds", "sourceCatalog", "sourcePolicy"],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "entityKey": { "type": "string", "pattern": "^[^:]+:[^/]+/.+$" },
    "title": { "type": "string", "minLength": 1 },
    "semester": { "type": "string", "minLength": 1 },
    "modules": { "type": "array" },
    "moduleIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "collectionIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "timelineLessonIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "collections": { "type": "array", "items": { "$ref": "collection.schema.json" } },
    "sourceCatalog": { "type": "array", "items": { "$ref": "source.schema.json" } },
    "schemaVersion": { "const": "nus.course.v1" }
  },
  "additionalProperties": true
}
