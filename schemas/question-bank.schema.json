{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nus-atlas.local/schemas/question-bank.schema.json",
  "title": "NUS Atlas question bank",
  "type": "object",
  "required": ["schemaVersion", "courseId", "questions"],
  "properties": {
    "schemaVersion": { "const": "nus.question-bank.v1" },
    "courseId": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "blueprint": { "type": "object" },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["sourceId", "sourceType", "page"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["lecture", "textbook", "ref", "assessment-derived"] },
        "page": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "question": {
      "type": "object",
      "required": ["id", "lessonId", "type", "difficulty", "skill", "cognitiveLevel", "estimatedSeconds", "prompt", "explanation", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "lessonId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["mcq", "short", "derivation", "calculation"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "skill": { "type": "string", "minLength": 1 },
        "cognitiveLevel": { "type": "string", "minLength": 1 },
        "estimatedSeconds": { "type": "integer", "minimum": 15 },
        "prompt": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "answer": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "required"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": true
          }
        },
        "solution": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "hint": { "type": "string", "minLength": 1 },
        "misconception": { "type": "string", "minLength": 1 },
        "visualHook": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
