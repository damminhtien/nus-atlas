  "id": "dsa5105-mdp-value-iteration",
  "title": "MDPs, value iteration, TD(0), and replay",
  "week": 8,
  "minutes": 90,
  "summary": "Compute Bellman backups, run value iteration, and connect model-based dynamic programming with TD learning and DQN replay.",
