  "criticalQuestions": [
    {
      "prompt": "If two singular-OLS parameter vectors produce the same training predictions, what can still differ?",
      "angle": "Look outside the row space of Phi and compare coefficient norms or predictions on new inputs.",
      "modelAnswer": "Their null-space components can differ. The training fit is unchanged, but coefficient magnitude and off-sample behavior can be very different.",
      "focus": "identifiability"
    },
    {
      "prompt": "Why does a small eigenvalue create a direction that ridge should suppress?",
      "angle": "Inspect how much the empirical design changes when the parameter moves along that eigenvector.",
      "modelAnswer": "A small eigenvalue means the sample objective has weak curvature in that direction, so noise can cause a large OLS coefficient change. Ridge multiplies that component by $\\mu/(\\mu+\\lambda)$.",
      "focus": "spectral regularization"
    },
    {
      "prompt": "Why is a low empirical risk not enough to claim a good learner?",
      "angle": "Name the expectation, the iid bridge, and the three possible error sources.",
      "modelAnswer": "Empirical risk is a sample average. It informs population risk only under a relevant sampling assumption and a suitable class/optimization process; it can be low while approximation, optimization, or generalization is still poor.",
      "focus": "generalization"
    },
    {
      "prompt": "What exactly is bounded in the Huber argument?",
      "angle": "Differentiate with respect to the residual and compare it with squared loss.",
      "modelAnswer": "The derivative $\\psi_delta(r)$, which is the residual's influence on the first-order condition, is capped at plus or minus $\\delta$ outside the quadratic region.",
      "focus": "robustness"
    }
  ],
