  "examples": [
    {
      "title": "Departments with at least two students",
      "sourceType": "exercise",
      "steps": [
        "Join Student to Department through the key relationship.",
        "Group by the department identity and display name.",
        "Compute $\\operatorname{COUNT}(*)$ for each group.",
        "Use `HAVING $COUNT(*) \\ge  2$` to keep completed groups."
      ],
      "answer": "The aggregate predicate belongs in HAVING because the count does not exist until grouping has happened."
    }
  ],
