  "math": [
    {
      "latex": "\\gamma_{\\mathrm{department\\_id};\\ \\operatorname{COUNT}(*)\\to n}(\\mathrm{Student})",
      "explanation": "The grouping operator partitions rows by department and computes one count per group. Conceptually, `WHERE` reduces rows before grouping, while `HAVING` filters the grouped result after the aggregate exists.",
      "symbols": [
        {
          "latex": "\\gamma",
          "meaning": "grouping and aggregation"
        },
        {
          "latex": "n",
          "meaning": "count produced for each group"
        }
      ],
      "name": "Relational grouping operator",
      "purpose": "Use it to express grouping by department and compute one aggregate per group.",
      "sourceType": "lecture"
    },
    {
      "latex": "\\mathrm{WHERE}\\ \\prec\\ \\mathrm{GROUP\\ BY}\\ \\prec\\ \\mathrm{HAVING}",
      "explanation": "This is a reasoning order, not a claim about the textual order of every SQL implementation. First decide which rows participate, then form groups, then filter aggregate groups.",
      "symbols": [
        {
          "latex": "\\prec",
          "meaning": "conceptually happens before"
        }
      ],
      "name": "SQL logical filtering order",
      "purpose": "Use it to decide whether a predicate belongs before grouping or after an aggregate is formed.",
      "sourceType": "lecture",
      "caveat": "SQL optimizers may rewrite execution plans while preserving relational semantics."
    },
    {
      "latex": "\\text{SELECT }A_1,\\ldots,A_n\\ \\text{FROM }r_1,\\ldots,r_m\\ \\text{WHERE }P",
      "name": "Basic SQL query shape",
      "purpose": "Use it to map output attributes, input relations, and row predicates.",
      "explanation": "This separates what to return from where to find it and which rows qualify.",
      "symbols": [
        {
          "latex": "A_1,\\ldots,A_n",
          "meaning": "projected attributes"
        },
        {
          "latex": "r_1,\\ldots,r_m",
          "meaning": "input relations"
        },
        {
          "latex": "P",
          "meaning": "row predicate"
        }
      ],
      "sourceType": "lecture",
      "sourceRefs": [
        {
          "sourceId": "DSA5104/chapter3.pdf",
          "page": 19,
          "sourceType": "lecture",
          "role": "basic query structure",
          "status": "current"
        }
      ]
    },
    {
      "latex": "\\text{FROM}\\to\\text{WHERE}\\to\\text{GROUP BY}\\to\\text{HAVING}\\to\\text{SELECT}\\to\\text{ORDER BY}",
      "name": "BIG 6 reasoning order",
      "purpose": "Use it to place row filters, group filters, projection, and sorting.",
      "explanation": "This is semantic reasoning order, not a claim that every physical execution follows the same sequence.",
      "symbols": [
        {
          "latex": "\\prec",
          "meaning": "conceptually happens before"
        }
      ],
      "sourceType": "lecture",
      "sourceRefs": [
