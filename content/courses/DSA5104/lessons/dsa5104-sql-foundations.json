          "role": "BIG 6",
          "status": "current"
        }
      ]
    },
    {
      "latex": "x\\mathbin{\\theta}\\operatorname{SOME}(Q)\\Longleftrightarrow\\exists q\\in Q:\\ x\\mathbin{\\theta}q",
      "name": "SOME as existential comparison",
      "purpose": "Use it when one satisfying value in a subquery is enough.",
      "explanation": "SOME succeeds when at least one returned value satisfies the comparison.",
      "symbols": [
        {
          "latex": "x",
          "meaning": "outer scalar value"
        },
        {
          "latex": "\\theta",
          "meaning": "comparison operator"
        },
