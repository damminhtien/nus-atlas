  "math": [
    {
      "latex": "\\forall t_1,t_2\\in r:\\ t_1[K]=t_2[K]\\Rightarrow t_1=t_2",
      "explanation": "A candidate key $K$ uniquely identifies a tuple: if two rows agree on all key attributes, they must be the same row. A primary key chooses one candidate key to enforce as the main identity.",
      "symbols": [
        {
          "latex": "K",
          "meaning": "candidate key attributes"
        },
        {
          "latex": "t[K]",
          "meaning": "projection of tuple $t$ onto $K$"
        },
        {
          "latex": "\\Rightarrow",
          "meaning": "logical implication"
        }
      ],
      "name": "Candidate-key uniqueness condition",
      "purpose": "Use it to test whether a set of attributes uniquely identifies every tuple.",
      "sourceType": "lecture"
    },
    {
      "latex": "\\mathrm{Student.department\\_id}\\ \\xrightarrow{\\mathrm{FK}}\\ \\mathrm{Department.id}",
      "explanation": "For a one-to-many relationship, place the referenced key on the many side. Many students can carry the same department identifier, while each identifier must point to an existing department unless nullability is explicitly allowed.",
      "symbols": [
        {
          "latex": "\\mathrm{FK}",
          "meaning": "foreign-key constraint"
        },
        {
          "latex": "\\mathrm{PK}",
          "meaning": "primary-key identity"
        }
      ],
      "name": "Foreign-key placement",
      "purpose": "Use it to encode the referenced key on the many side of a one-to-many relationship.",
      "sourceType": "lecture"
    },
