      "id": "dsa5104-relational-model-section-2",
      "type": "teaching-note",
      "title": "Identity and referential integrity",
      "body": "A primary key chooses a stable unique identity for each tuple. A foreign key carries a referenced identity into another relation and constrains links to existing keys unless nullability is explicitly allowed.",
      "sourceType": "lecture",
      "sourceRefs": [
        {
          "sourceId": "DSA5104/chapter1.pdf",
          "page": 25,
          "sourceType": "lecture",
          "role": "primary-key integrity constraint",
          "status": "current"
        }
      ]
    },
    {
      "id": "dsa5104-relational-model-formula-1",
      "type": "formula",
      "name": "Candidate-key uniqueness condition",
      "purpose": "Use it to test whether a set of attributes uniquely identifies every tuple.",
      "latex": "\\forall t_1,t_2\\in r:\\ t_1[K]=t_2[K]\\Rightarrow t_1=t_2",
      "explanation": "A candidate key $K$ uniquely identifies a tuple: if two rows agree on all key attributes, they must be the same row. A primary key chooses one candidate key to enforce as the main identity.",
      "symbols": [
        {
          "latex": "K",
          "meaning": "candidate key attributes"
        },
        {
          "latex": "t[K]",
          "meaning": "projection of tuple $t$ onto $K$"
        },
        {
          "latex": "\\Rightarrow",
          "meaning": "logical implication"
        }
      ],
