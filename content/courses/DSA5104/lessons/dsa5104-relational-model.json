  "examples": [
    {
      "title": "Department–Student relationship",
      "sourceType": "exercise",
      "steps": [
        "Department has primary key $\\text{id}$.",
        "Student stores $\\text{department\\_id}$ as a foreign key.",
        "The foreign key belongs on the many side of a one-to-many relationship.",
        "A constraint check rejects a student row that references a missing department."
      ],
      "answer": "The design preserves one student per tuple while allowing many students to reference one department."
    }
  ],
  "contrastDrills": [
    {
      "id": "dsa5104-contrast-key-fk",
      "type": "contrast",
      "kind": "concept-contrast",
      "pair": "Primary key vs foreign key",
      "prompt": "Which constraint primarily expresses a link to an identity in another relation?",
      "choices": [
        "Primary key",
        "Foreign key",
        "Check constraint",
        "View"
      ],
      "answer": 1,
      "explanation": "A foreign key references a candidate or primary key in another relation; a primary key identifies tuples in its own relation.",
      "estimatedSeconds": 45,
      "difficulty": "medium",
      "skill": "concept-contrast",
      "cognitiveLevel": "distinguish",
      "misconception": "Name the boundary between the two concepts before choosing.",
      "sourceRefs": [
        {
          "sourceId": "DSA5104/chapter1.pdf",
          "page": 25,
          "sourceType": "lecture",
          "role": "integrity constraints",
          "status": "current"
        }
      ]
    },
    {
      "id": "dsa5104-contrast-relational-er",
      "type": "contrast",
      "kind": "concept-contrast",
      "pair": "Relational model vs ER model",
      "prompt": "Which representation is mainly used to design entities and relationships before implementation tables?",
      "choices": [
        "Relational model",
        "Entity–Relationship model",
        "Physical storage model",
        "Data dictionary"
      ],
      "answer": 1,
      "explanation": "The ER model is a design representation; the relational model is the table-based implementation model.",
      "estimatedSeconds": 45,
      "difficulty": "medium",
      "skill": "concept-contrast",
      "cognitiveLevel": "distinguish",
      "misconception": "Name the boundary between the two concepts before choosing.",
      "sourceRefs": [
        {
          "sourceId": "DSA5104/chapter1.pdf",
          "page": 13,
          "sourceType": "lecture",
          "role": "data-model categories",
          "status": "current"
        }
      ]
    }
  ],
  "math": [
    {
      "latex": "\\forall t_1,t_2\\in r:\\ t_1[K]=t_2[K]\\Rightarrow t_1=t_2",
      "explanation": "A candidate key $K$ uniquely identifies a tuple: if two rows agree on all key attributes, they must be the same row. A primary key chooses one candidate key to enforce as the main identity.",
      "symbols": [
        {
          "latex": "K",
          "meaning": "candidate key attributes"
        },
        {
          "latex": "t[K]",
          "meaning": "projection of tuple $t$ onto $K$"
        },
        {
          "latex": "\\Rightarrow",
          "meaning": "logical implication"
        }
      ],
      "sourceType": "lecture"
    },
    {
      "latex": "\\mathrm{Student.department\\_id}\\ \\xrightarrow{\\mathrm{FK}}\\ \\mathrm{Department.id}",
      "explanation": "For a one-to-many relationship, place the referenced key on the many side. Many students can carry the same department identifier, while each identifier must point to an existing department unless nullability is explicitly allowed.",
      "symbols": [
        {
          "latex": "\\mathrm{FK}",
          "meaning": "foreign-key constraint"
        },
        {
          "latex": "\\mathrm{PK}",
          "meaning": "primary-key identity"
        }
      ],
      "sourceType": "lecture"
    }
  ],
  "criticalQuestions": [
    {
      "prompt": "What goes wrong if the foreign key is placed on the one side of a one-to-many relationship?",
      "angle": "Try representing one department with many students without repeating or nesting values.",
      "modelAnswer": "A single department row cannot hold an unbounded set of student identities in a first-normal-form relation; placing the key on Student preserves one value per row and avoids repeating department data.",
      "focus": "schema design"
    },
    {
      "prompt": "Can a primary key be technically unique but still be a bad business identifier?",
      "angle": "Separate database uniqueness from stable, meaningful identity.",
      "modelAnswer": "Yes. A generated row number may be unique but not stable across systems or meaningful to users; the choice depends on lifecycle, integration, and update requirements.",
      "focus": "identity"
    }
  ],
