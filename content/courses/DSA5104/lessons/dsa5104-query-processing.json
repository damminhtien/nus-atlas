        }
      ]
    },
    {
      "id": "dsa5104-contrast-index-table",
      "type": "contrast",
      "kind": "concept-contrast",
      "pair": "Index lookup vs full scan",
      "prompt": "What is the main purpose of an index?",
      "choices": [
        "Change the logical schema",
        "Provide pointers for faster access",
        "Guarantee a correct join",
        "Replace constraints"
      ],
      "answer": 1,
      "explanation": "An index provides an access path to data items; it does not replace logical integrity constraints.",
      "estimatedSeconds": 45,
      "difficulty": "medium",
      "skill": "concept-contrast",
      "cognitiveLevel": "distinguish",
      "misconception": "Name the boundary between the two concepts before choosing.",
      "sourceRefs": [
        {
          "sourceId": "DSA5104/chapter1.pdf",
          "page": 38,
          "sourceType": "lecture",
          "role": "indexes",
          "status": "current"
        }
      ]
    }
  ],
  "math": [
    {
      "latex": "Q \\xrightarrow{\\mathrm{parse/translate}} Q' \\xrightarrow{\\mathrm{optimize}} P \\xrightarrow{\\mathrm{evaluate}} r",
      "explanation": "The query processor turns a declarative query into an internal form, selects a physical plan, and evaluates that plan to produce a relation. The stages can be optimized internally while preserving the same logical result.",
      "symbols": [
        {
          "latex": "Q",
          "meaning": "declared SQL query"
        },
        {
          "latex": "P",
          "meaning": "chosen physical evaluation plan"
        },
        {
          "latex": "r",
          "meaning": "result relation"
        }
      ],
      "name": "Query-processing pipeline",
      "purpose": "Use it to preserve the logical result while moving from a declared query to an optimized physical plan.",
      "sourceType": "lecture"
    }
  ],
  "criticalQuestions": [
    {
      "prompt": "What must remain invariant when the optimizer changes the plan?",
      "angle": "Separate the access path and operator order from the relation the query promises.",
      "modelAnswer": "The logical result relation must remain the same; only the physical route, such as an index lookup versus a scan, changes.",
      "focus": "semantic preservation"
    },
    {
      "prompt": "Why is an index not automatically faster than a full table scan?",
      "angle": "Compare the number of qualifying rows, index locality, and the cost of fetching the base tuples.",
      "modelAnswer": "For a highly selective predicate an index can avoid most pages, but when many rows qualify the random lookups and index traversal can cost more than a sequential scan.",
      "focus": "access-path trade-off"
    }
  ],
